{
  "name": "@black942026/harness-acp-bridge-pi-extension",
  "version": "0.1.9",
  "description": "Thin Pi HTTP client for harness-acp-bridge with synchronous send/wait and reverse-request interaction",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/black-94/harness-acp-bridge-pi-extension.git"
  },
  "homepage": "https://github.com/black-94/harness-acp-bridge-pi-extension#readme",
  "bugs": {
    "url": "https://github.com/black-94/harness-acp-bridge-pi-extension/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "acp",
    "harness",
    "http"
  ],
  "files": [
    "index.ts",
    "src",
    "skills",
    "README.md",
    "config.example.json",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:protocol": "vitest run --config vitest.protocol.config.ts",
    "parity": "node scripts/redaction-parity.mjs",
    "dev:setup": "npm ci --ignore-scripts && npm run fix:dev-deps",
    "fix:dev-deps": "node scripts/fix-dev-dependencies.mjs",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run fix:dev-deps && npm run check"
  },
  "dependencies": {
    "@black942026/harness-acp-bridge-server": "^0.1.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^22.19.0",
    "@types/semver": "^7.8.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
